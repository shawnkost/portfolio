---
import Section from '@/components/Section.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { site } from '@/data/site';
---

<Section id="contact" heading="Say hello" class="pt-2xl pb-4xl">
  <p class="prose-measure text-md">
    I&rsquo;m not looking for new opportunities right now, but my inbox is
    always open. If you have a question, or just want to say hi, I&rsquo;ll do
    my best to get back to you.
  </p>

  <div class="mt-xl gap-lg flex flex-wrap items-center">
    <a
      href={`mailto:${site.email}`}
      class="border-accent text-accent hover:bg-accent hover:text-surface px-lg py-sm inline-flex items-center rounded-full border font-mono text-xs font-medium whitespace-nowrap transition-colors"
    >
      {site.email}
    </a>

    <SocialLinks />
  </div>
</Section>
