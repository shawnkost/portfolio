---
import SocialLinks from '@/components/SocialLinks.astro';
import { site } from '@/data/site';
---
<section class="px-lg pt-3xl pb-2xl sm:pt-4xl mx-auto max-w-5xl">
  <p class="label mb-lg">{site.role}</p>

  <h1 class="text-display text-ink">{site.name}</h1>

  <p class="prose-measure mt-lg text-md">
    I build the front end of web applications in React and TypeScript. I know
    enough Node to ship a whole feature on my own.
  </p>

  <div class="mt-xl gap-lg flex flex-wrap items-center">
    <a
      href={site.resume}
      target="_blank"
      rel="noopener"
      class="border-accent text-accent hover:bg-accent hover:text-surface gap-xs px-lg py-sm inline-flex items-center rounded-full border font-mono text-xs font-medium tracking-widest whitespace-nowrap uppercase transition-colors"
    >
      My resume
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17 17 7M9 7h8v8"></path>
      </svg>
    </a>

    <SocialLinks />
  </div>
</section>
